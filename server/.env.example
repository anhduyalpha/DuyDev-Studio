# Security & Authentication (none | token)
AUTH_MODE=none
API_KEY=duydev_super_secret_token_2026

# CORS Origin for PWA Client
CORS_ORIGIN=http://localhost:3000

# Studocu Downloader Engine Backend URL
STUDOCU_API_URL=http://127.0.0.1:8090
